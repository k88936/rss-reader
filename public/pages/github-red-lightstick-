</span></span><span style="display:flex;"><span>python3 lightstick.py --r <span style="color:#a5d6ff">0</span> --g <span style="color:#a5d6ff">255</span> --b <span style="color:#a5d6ff">0</span> <span style="color:#8b949e;font-style:italic"># 绿色</span>
</span></span><span style="display:flex;"><span>python3 lightstick.py --r <span style="color:#a5d6ff">0</span> --g <span style="color:#a5d6ff">0</span> --b <span style="color:#a5d6ff">255</span> <span style="color:#8b949e;font-style:italic"># 蓝色</span>
</span></span><span style="display:flex;"><span>python3 lightstick.py --r <span style="color:#a5d6ff">255</span> --g <span style="color:#a5d6ff">255</span> --b <span style="color:#a5d6ff">0</span> <span style="color:#8b949e;font-style:italic"># 黄色</span>
</span></span><span style="display:flex;"><span>python3 lightstick.py --r <span style="color:#a5d6ff">0</span> --g <span style="color:#a5d6ff">0</span> --b <span style="color:#a5d6ff">0</span> <span style="color:#8b949e;font-style:italic"># 关灯</span>
